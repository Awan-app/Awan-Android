+    val emoji: String,
+    val status: GoalStatus = GoalStatus.ACTIVE,
+    val tasks: List<Task> = emptyList(),
+) {
+    val totalTasks: Int
+        get() = tasks.size
+
+    val completedTasks: Int
+        get() = tasks.count { it.status == TaskStatus.COMPLETED }
+
