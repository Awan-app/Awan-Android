+                      }
+                  }
+                  is GoalStep.WritingQuestion -> {
+                      item {
+                          AwanText(
+                              text = step.question,
+                              style = AwanTheme.typography.title.copy(color = AwanTheme.colors.textPrimary),
+                          )
+                      }
+                  }
+                  else -> Unit
+              }
+
+              // Error
+              val errRes = state.errorMessage
+              if (errRes != null) {
+                  item {
+                      AwanText(
+                          text = stringResource(errRes),
+                          style = AwanTheme.styles.errorText,
+                      )
+                  }
+              }
+              if (speechError != null) {
+                  item {
+                      AwanText(
+                          text = speechError,
