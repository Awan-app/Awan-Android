+                AwanText(
+                    text = token.maskedToken,
+                    style = AwanTheme.styles.captionText.let { it.copy(textStyle = it.textStyle.copy(fontFamily = FontFamily.Monospace)) }
+                )
+                AwanText(
+                    text = token.createdAt,
+                    style = AwanTheme.styles.captionText
