<resources>

    <!-- Channels -->
    <string name="notifications_channel_session_reminders_name">تذكيرات الجلسات</string>
    <string name="notifications_channel_session_reminders_description">تنبيه قبل بدء الجلسة المجدولة بقليل.</string>
    <string name="notifications_channel_session_live_name">جلسة جارية</string>
    <string name="notifications_channel_session_live_description">تقدّم مباشر أثناء تشغيل الجلسة.</string>
    <string name="notifications_channel_session_end_name">الجلسات المنتهية</string>
    <string name="notifications_channel_session_end_description">تنبيه عند انتهاء وقت الجلسة.</string>
    <string name="notifications_channel_nudges_name">تنبيهات يومية</string>
    <string name="notifications_channel_nudges_description">نظرة صباحية على يومك، وتذكير قبل أن ينتهي.</string>
    <string name="notifications_channel_rewards_name">المكافآت والعجلة اليومية</string>
    <string name="notifications_channel_rewards_description">النقاط والسلاسل والعجلة اليومية.</string>

    <!-- Content -->
    <string name="notifications_time_range">%1$s – %2$s</string>

    <plurals name="notifications_reminder_text">
        <item quantity="zero">تبدأ خلال %1$d دقيقة · %2$s</item>
        <item quantity="one">تبدأ خلال دقيقة واحدة · %2$s</item>
        <item quantity="two">تبدأ خلال دقيقتين · %2$s</item>
        <item quantity="few">تبدأ خلال %1$d دقائق · %2$s</item>
        <item quantity="many">تبدأ خلال %1$d دقيقة · %2$s</item>
        <item quantity="other">تبدأ خلال %1$d دقيقة · %2$s</item>
    </plurals>

    <string name="notifications_session_ended_title">هل أنهيت %1$s؟</string>
    <string name="notifications_session_ended_text">انتهت جلستك للتو · %1$s</string>

    <string name="notifications_follow_up_title">كيف سارت %1$s؟</string>
    <string name="notifications_follow_up_text">ما زالت مفتوحة منذ وقت سابق · %1$s. حدّدها كمكتملة لتُحتسب.</string>

    <!-- Never mentions a streak number: the streak is server-owned and this device cannot know it. -->
    <string name="notifications_streak_risk_title">يومك يوشك على الانتهاء</string>
    <string name="notifications_streak_risk_text">لم تُنهِ شيئاً اليوم بعد. جلسة قصيرة واحدة تكفي — مهما كانت صغيرة.</string>

    <string name="notifications_daily_brief_title">صباح الخير</string>
    <string name="notifications_daily_brief_empty_text">لا يوجد شيء مخطط اليوم. دقيقتان الآن، وبقية اليوم تُخطط نفسها.</string>
    <plurals name="notifications_daily_brief_text">
        <item quantity="zero">%1$d جلسة اليوم · %2$s في %3$s</item>
        <item quantity="one">جلسة واحدة اليوم · %2$s في %3$s</item>
        <item quantity="two">جلستان اليوم · %2$s أولاً، في %3$s</item>
        <item quantity="few">%1$d جلسات اليوم · %2$s أولاً، في %3$s</item>
        <item quantity="many">%1$d جلسة اليوم · %2$s أولاً، في %3$s</item>
        <item quantity="other">%1$d جلسة اليوم · %2$s أولاً، في %3$s</item>
    </plurals>

    <!-- Status bar chip on Android 16+; kept very short because the chip truncates hard. -->
    <string name="notifications_live_short_remaining">%1$d د</string>

    <!-- Actions -->
    <string name="notifications_action_complete_now">إنهاء الآن</string>
    <!-- Clears the running-session notification and changes nothing about the session itself. -->
    <string name="notifications_action_stop">إيقاف</string>
    <string name="notifications_action_snooze">تأجيل</string>
    <string name="notifications_action_reschedule">إعادة جدولة</string>
    <string name="notifications_action_complete">تحديد كمكتملة</string>

