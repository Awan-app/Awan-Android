<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Channels -->
    <string name="notifications_channel_session_reminders_name">Session reminders</string>
    <string name="notifications_channel_session_reminders_description">A nudge shortly before a scheduled session starts.</string>
    <string name="notifications_channel_session_live_name">Running session</string>
    <string name="notifications_channel_session_live_description">Live progress while a session is running.</string>
    <string name="notifications_channel_session_end_name">Finished sessions</string>
    <string name="notifications_channel_session_end_description">A prompt when a session\'s time is up.</string>
    <string name="notifications_channel_nudges_name">Daily nudges</string>
    <string name="notifications_channel_nudges_description">A morning look at your day, and a reminder before it ends.</string>
    <string name="notifications_channel_rewards_name">Rewards and daily spin</string>
    <string name="notifications_channel_rewards_description">Points, streaks and the daily wheel.</string>

    <!-- Content -->
    <string name="notifications_time_range">%1$s – %2$s</string>

    <plurals name="notifications_reminder_text">
        <item quantity="one">Starts in %1$d minute · %2$s</item>
        <item quantity="other">Starts in %1$d minutes · %2$s</item>
    </plurals>

    <string name="notifications_session_ended_title">Did you finish %1$s?</string>
    <string name="notifications_session_ended_text">Your session just ended · %1$s</string>

    <string name="notifications_follow_up_title">How did %1$s go?</string>
    <string name="notifications_follow_up_text">Still open from earlier · %1$s. Mark it done and it counts.</string>

    <!-- Never mentions a streak number: the streak is server-owned and this device cannot know it. -->
    <string name="notifications_streak_risk_title">Your day is nearly over</string>
    <string name="notifications_streak_risk_text">Nothing finished yet today. One short session still counts — even a small one.</string>

    <string name="notifications_daily_brief_title">Good morning</string>
    <string name="notifications_daily_brief_empty_text">Nothing planned today. Two minutes now, and the rest of the day plans itself.</string>
    <plurals name="notifications_daily_brief_text">
        <item quantity="one">%1$d block today · %2$s at %3$s</item>
        <item quantity="other">%1$d blocks today · %2$s is first, at %3$s</item>
    </plurals>

    <!-- Status bar chip on Android 16+; kept very short because the chip truncates hard. -->
    <string name="notifications_live_short_remaining">%1$dm</string>

    <!-- Actions -->
    <string name="notifications_action_complete_now">Complete now</string>
    <!-- Clears the running-session notification and changes nothing about the session itself. -->
    <string name="notifications_action_stop">Stop</string>
    <string name="notifications_action_snooze">Snooze</string>
    <string name="notifications_action_reschedule">Reschedule</string>
    <string name="notifications_action_complete">Mark complete</string>

</resources>
